# ---------------------------------------------------------------
# Think Positive Always — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# The site builds and runs with NONE of these set.
# ---------------------------------------------------------------

# Public base URL used for canonical URLs, sitemap, robots and Open Graph.
# Falls back to http://localhost:3000 when unset. Set this in production.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only on the production deployment to allow search indexing.
# Any other value (including unset) emits noindex robots directives.
NEXT_PUBLIC_ALLOW_INDEXING=

# Optional public contact / partnership email addresses (shown only when set).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PARTNERSHIPS_EMAIL=

# Optional social profile URLs (links are hidden when unset).
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_PINTEREST=

