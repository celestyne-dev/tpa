# ---------------------------------------------------------------
# Think Positive Always — backend (Flask) environment
# Copy to .env (never commit it). Server-side only.
# ---------------------------------------------------------------

# development | testing | production
FLASK_CONFIG=development

# Required in production. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Signs admin session tokens (min. 32 characters in production). Never expose it to the frontend.
JWT_SECRET_KEY=

# Session lifetimes (defaults: 15-minute access token, 14-day refresh token).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Session cookies are Secure in production automatically; set true to force it elsewhere (HTTPS).
JWT_COOKIE_SECURE=false
# Only set when the admin must share cookies across subdomains (normally leave empty).
JWT_COOKIE_DOMAIN=

# Rate limiting storage. memory:// works for one process; use redis:// with several workers.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=5 per minute;20 per hour

# Where the prerender step writes its manifest (used for the "rebuild required" indicator).
# Defaults to ../frontend/dist/prerender-manifest.json
FRONTEND_BUILD_MANIFEST=

# Database. Development falls back to SQLite (backend/instance/tpa-dev.db).
# Production must use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://tpa_user:CHANGE_ME@127.0.0.1:5432/tpa
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when running behind Nginx (trusts X-Forwarded-* from one proxy).
TRUST_PROXY=0

# Optional fallbacks for public business settings. Values saved in Admin → Settings take
# precedence; these are used only until a value is saved there.
CONTACT_EMAIL=
PARTNERSHIPS_EMAIL=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_PINTEREST=
# Default for the "Newsletter sign-ups open" setting. Forms still appear only when
# sending (test/live) and consent wording are configured in /admin/email-settings.
NEWSLETTER_OPEN=false
MEDIA_KIT_URL=

# ---- Email and account links (invitations, password reset links) ----
# none | console | smtp. Development defaults to "console": links are printed in the
# Flask terminal only (never emailed, never returned by the API). "console" is refused
# in production; use "smtp" there.
MAIL_BACKEND=
MAIL_FROM=Think Positive Always <no-reply@example.com>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# Public origin of the admin used in emailed links.
ADMIN_BASE_URL=http://localhost:5173
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# ---- Media library (Batch 03) ----
# local (default) | s3 (adapter slot, not activated yet)
MEDIA_STORAGE=local
# public/ (optimised derivatives, served by Nginx at /media/) and private/
# (retained originals, never served) are created inside this directory.
MEDIA_ROOT=
MEDIA_PUBLIC_BASE_URL=/media
# Development serves /media from Flask; production must use Nginx (leave unset).
# MEDIA_SERVE_FROM_FLASK=true
MEDIA_MAX_UPLOAD_MB=20
MEDIA_MAX_PIXELS=50000000
MEDIA_MAX_DIMENSION=12000
# original = keep the uploaded file privately; master = keep a metadata-free copy.
MEDIA_RETENTION=original
MEDIA_ENABLE_AVIF=true
MEDIA_SUPERSEDED_RETENTION_DAYS=14

# ---- SEO ----
# Public site origin (same as VITE_SITE_URL), used for canonical checks and sitemaps.
SITE_URL=http://localhost:5173
# Comma-separated external hosts redirects may point to (open-redirect protection).
REDIRECT_ALLOWED_HOSTS=

# ---- Static publishing pipeline (flask publish worker) ----
# FRONTEND_DIR=/var/www/tpa/frontend
# PUBLISH_RELEASES_DIR=/var/www/tpa-site/releases
# PUBLISH_CURRENT_LINK=/var/www/tpa-site/current
# FRONTEND_BUILD_MANIFEST=/var/www/tpa-site/current/prerender-manifest.json
PUBLISH_API_URL=http://127.0.0.1:5000/api/v1
PUBLISH_KEEP_RELEASES=5
PUBLISH_DEBOUNCE_SECONDS=30
PUBLISH_MAX_DELAY_SECONDS=300
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_BUILD_TIMEOUT_SECONDS=900
# JSON argv list, no shell. Default: ["npm", "run", "build"]
# PUBLISH_BUILD_COMMAND=
# Optional remote/CDN deploy hook run after each release, JSON argv ({release} = path).
# PUBLISH_DEPLOY_COMMAND=["rsync", "-a", "--delete", "{release}/", "deploy@host:/srv/site/"]

# ---- Testing only: run pytest against a disposable PostgreSQL database ----
# TEST_DATABASE_URL=postgresql+psycopg://tpa_test:CHANGE_ME@127.0.0.1:5432/tpa_pytest

# ---- Digital products: private files (Batch 05; see docs/commerce.md) ----
# Private storage for paid files. Never inside the web root, the media library or Git.
PRODUCT_FILES_STORAGE=local
# Default: backend/instance/product-files
PRODUCT_FILES_ROOT=
PRODUCT_FILE_MAX_MB=300
PRODUCT_ZIP_MAX_UNCOMPRESSED_MB=1024
PRODUCT_ZIP_MAX_ENTRIES=2000
PRODUCT_ZIP_MAX_RATIO=100
PRODUCT_FILES_MIN_FREE_MB=500
# Optional malware scanner, JSON argv list run by the worker without a shell.
# Exit 0 = clean, 1 = infected. Example:
# PRODUCT_FILES_SCAN_COMMAND=["clamdscan", "--no-summary", "--fdpass", "{path}"]
PRODUCT_FILES_SCAN_COMMAND=
PRODUCT_FILES_SCAN_TIMEOUT_SECONDS=300
# Nginx internal location mapped to PRODUCT_FILES_ROOT (X-Accel-Redirect). Empty = Flask streams.
# PRODUCT_FILES_ACCEL_REDIRECT_PREFIX=/_protected_downloads
DOWNLOAD_LINK_TTL_SECONDS=300
DOWNLOAD_LINK_MAX_USES=5
RATELIMIT_DOWNLOADS=30 per minute;300 per day

# ---- Customer accounts (separate from administrators) ----
CUSTOMER_SESSION_DAYS=30
# Forced on in production (HTTPS).
CUSTOMER_COOKIE_SECURE=false
CUSTOMER_VERIFY_TTL_HOURS=48
CUSTOMER_RESET_TTL_MINUTES=60
RATELIMIT_CUSTOMER_REGISTER=5 per minute;30 per hour
RATELIMIT_CHECKOUT=10 per minute;60 per hour

# ---- Payments: Paystack (checkout stays disabled until enabled in /admin/payments) ----
# Secret key from Paystack Dashboard > Settings > API Keys & Webhooks. Server-side only.
# Use a sk_test_ key for development; never commit a real key. The webhook signature is
# verified with this same key (Paystack has no separate webhook secret).
PAYSTACK_SECRET_KEY=
# Optional, informational only (hosted checkout does not need it in the browser).
PAYSTACK_PUBLIC_KEY=
# Leave as the official API. Development may point at scripts/paystack_mock.py
# (http://127.0.0.1:8765); production refuses anything else.
PAYSTACK_API_BASE=https://api.paystack.co
PAYSTACK_TIMEOUT_SECONDS=20
# Optional comma-separated source IPs for webhooks (signatures are always checked).
PAYSTACK_WEBHOOK_IPS=
# Live (real money) checkout is impossible unless this is true AND the admin readiness
# checklist passes. Keep false until the live activation checklist is complete.
PAYMENTS_LIVE_ALLOWED=false
# Development only: any verified customer may use test-mode checkout. Refused in production.
PAYMENTS_TEST_CHECKOUT_PUBLIC=false

# ---- Newsletter & email marketing (Batch 06; see docs/newsletter.md) ----
# Delivery backend for newsletter mail: smtp | none (console only in development).
# Empty = same as MAIL_BACKEND. Never put credentials anywhere but this file.
NEWSLETTER_MAIL_BACKEND=
# Sender on a domain with SPF, DKIM and DMARC for your provider (e.g. news@yourdomain).
NEWSLETTER_FROM_EMAIL=
# Optional separate SMTP account for bulk mail (falls back to MAIL_SMTP_*).
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=
NEWSLETTER_SMTP_USERNAME=
NEWSLETTER_SMTP_PASSWORD=
NEWSLETTER_SEND_RATE_PER_MINUTE=60
NEWSLETTER_BATCH_SIZE=50
NEWSLETTER_MAX_ATTEMPTS=5
NEWSLETTER_STALE_CLAIM_MINUTES=15
# Comma-separated addresses that receive mail while sending mode is "test".
NEWSLETTER_TEST_RECIPIENTS=
NEWSLETTER_CONFIRM_TTL_HOURS=72
# Live (bulk) sending is impossible unless true AND the admin readiness checks pass.
NEWSLETTER_LIVE_ALLOWED=false
# Shared secret for signed bounce/complaint/delivery feedback (HMAC-SHA256).
EMAIL_FEEDBACK_SECRET=
LEAD_MAGNET_LINK_TTL_HOURS=72
LEAD_MAGNET_MAX_DOWNLOADS=10
RATELIMIT_NEWSLETTER_SIGNUP=5 per minute;30 per hour

# ---- Partnerships (Batch 07) ----
# Internal address told about new partnership inquiries. Only used when MAIL_BACKEND really
# sends; falls back to PARTNERSHIPS_EMAIL. Contact details stay in the admin.
PARTNERSHIP_NOTIFY_EMAIL=
RATELIMIT_PARTNERSHIP_INQUIRY=5 per minute;20 per hour
