# ---------------------------------------------------------------
# Think Positive Always — backend (Flask) environment
# Copy to .env (never commit it). Server-side only.
# ---------------------------------------------------------------

# development | testing | production
FLASK_CONFIG=development

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database. Development falls back to SQLite (backend/instance/tpa-dev.db).
# Production must use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://tpa_user:CHANGE_ME@127.0.0.1:5432/tpa
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when running behind Nginx (trusts X-Forwarded-* from one proxy).
TRUST_PROXY=0

# Public business settings returned by GET /api/v1/site (optional; hidden when empty).
CONTACT_EMAIL=
PARTNERSHIPS_EMAIL=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_PINTEREST=
# Flip to true only once a real email provider is integrated.
NEWSLETTER_OPEN=false
MEDIA_KIT_URL=

# ---- Future batches (not used yet) ----
# JWT_SECRET_KEY=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=
