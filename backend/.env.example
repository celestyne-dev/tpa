# ---------------------------------------------------------------
# Think Positive Always — backend (Flask) environment
# Copy to .env (never commit it). Server-side only.
# ---------------------------------------------------------------

# development | testing | production
FLASK_CONFIG=development

# Required in production. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Signs admin session tokens (min. 32 characters in production). Never expose it to the frontend.
JWT_SECRET_KEY=

# Session lifetimes (defaults: 15-minute access token, 14-day refresh token).
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
# Session cookies are Secure in production automatically; set true to force it elsewhere (HTTPS).
JWT_COOKIE_SECURE=false
# Only set when the admin must share cookies across subdomains (normally leave empty).
JWT_COOKIE_DOMAIN=

# Rate limiting storage. memory:// works for one process; use redis:// with several workers.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=5 per minute;20 per hour

# Where the prerender step writes its manifest (used for the "rebuild required" indicator).
# Defaults to ../frontend/dist/prerender-manifest.json
FRONTEND_BUILD_MANIFEST=

# Database. Development falls back to SQLite (backend/instance/tpa-dev.db).
# Production must use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://tpa_user:CHANGE_ME@127.0.0.1:5432/tpa
DATABASE_URL=

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 when running behind Nginx (trusts X-Forwarded-* from one proxy).
TRUST_PROXY=0

# Optional fallbacks for public business settings. Values saved in Admin → Settings take
# precedence; these are used only until a value is saved there.
CONTACT_EMAIL=
PARTNERSHIPS_EMAIL=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_X=
SOCIAL_YOUTUBE=
SOCIAL_TIKTOK=
SOCIAL_PINTEREST=
# Flip to true only once a real email provider is integrated.
NEWSLETTER_OPEN=false
MEDIA_KIT_URL=

# ---- Email and account links (invitations, password reset links) ----
# none | console | smtp. Development defaults to "console": links are printed in the
# Flask terminal only (never emailed, never returned by the API). "console" is refused
# in production; use "smtp" there.
MAIL_BACKEND=
MAIL_FROM=Think Positive Always <no-reply@example.com>
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
# Public origin of the admin used in emailed links.
ADMIN_BASE_URL=http://localhost:5173
INVITATION_TTL_HOURS=72
PASSWORD_RESET_TTL_MINUTES=60

# ---- Media library (Batch 03) ----
# local (default) | s3 (adapter slot, not activated yet)
MEDIA_STORAGE=local
# public/ (optimised derivatives, served by Nginx at /media/) and private/
# (retained originals, never served) are created inside this directory.
MEDIA_ROOT=
MEDIA_PUBLIC_BASE_URL=/media
# Development serves /media from Flask; production must use Nginx (leave unset).
# MEDIA_SERVE_FROM_FLASK=true
MEDIA_MAX_UPLOAD_MB=20
MEDIA_MAX_PIXELS=50000000
MEDIA_MAX_DIMENSION=12000
# original = keep the uploaded file privately; master = keep a metadata-free copy.
MEDIA_RETENTION=original
MEDIA_ENABLE_AVIF=true
MEDIA_SUPERSEDED_RETENTION_DAYS=14

# ---- SEO ----
# Public site origin (same as VITE_SITE_URL), used for canonical checks and sitemaps.
SITE_URL=http://localhost:5173
# Comma-separated external hosts redirects may point to (open-redirect protection).
REDIRECT_ALLOWED_HOSTS=

# ---- Static publishing pipeline (flask publish worker) ----
# FRONTEND_DIR=/var/www/tpa/frontend
# PUBLISH_RELEASES_DIR=/var/www/tpa-site/releases
# PUBLISH_CURRENT_LINK=/var/www/tpa-site/current
# FRONTEND_BUILD_MANIFEST=/var/www/tpa-site/current/prerender-manifest.json
PUBLISH_API_URL=http://127.0.0.1:5000/api/v1
PUBLISH_KEEP_RELEASES=5
PUBLISH_DEBOUNCE_SECONDS=30
PUBLISH_MAX_DELAY_SECONDS=300
PUBLISH_MAX_ATTEMPTS=3
PUBLISH_BUILD_TIMEOUT_SECONDS=900
# JSON argv list, no shell. Default: ["npm", "run", "build"]
# PUBLISH_BUILD_COMMAND=
# Optional remote/CDN deploy hook run after each release, JSON argv ({release} = path).
# PUBLISH_DEPLOY_COMMAND=["rsync", "-a", "--delete", "{release}/", "deploy@host:/srv/site/"]

# ---- Testing only: run pytest against a disposable PostgreSQL database ----
# TEST_DATABASE_URL=postgresql+psycopg://tpa_test:CHANGE_ME@127.0.0.1:5432/tpa_pytest

# ---- Future batches (not used yet) ----
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# EMAIL_PROVIDER_API_KEY=
