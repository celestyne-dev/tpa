# ---------------------------------------------------------------
# Think Positive Always — frontend (Vite) environment
# Copy to .env.local. Only VITE_* variables reach the browser bundle:
# never put secrets here.
# ---------------------------------------------------------------

# Public base URL used for canonical URLs, sitemap and Open Graph.
# Defaults to http://localhost:5173 when unset. Set in production builds.
VITE_SITE_URL=

# Set to "true" ONLY for the verified production build to allow indexing.
# Any other value emits noindex meta tags and a disallow-all robots.txt.
# A Super Admin can additionally switch indexing off (never on) in the CMS:
# Settings → Technical → "Allow search engines to index the site".
VITE_ALLOW_INDEXING=

# API base URL used by the browser. Keep relative ("/api/v1") when Nginx
# (production) or the Vite dev proxy (development) forwards /api to Flask.
VITE_API_BASE_URL=/api/v1

# --- Build/dev tooling only (not exposed to the browser) ---
# Flask origin for the Vite dev-server proxy.
API_PROXY_TARGET=http://127.0.0.1:5000
# Flask API used by the prerender step during `npm run build`.
PRERENDER_API_URL=http://127.0.0.1:5000/api/v1
