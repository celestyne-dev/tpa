# /etc/systemd/system/tpa-media-prune.service  (example)
# Deletes image variants superseded (by replacement or focal-point changes) more
# than MEDIA_SUPERSEDED_RETENTION_DAYS ago. Run it after rebuilds have picked up
# the new files.
[Unit]
Description=Think Positive Always: prune superseded media variants

[Service]
Type=oneshot
User=tpa
Group=www-data
WorkingDirectory=/var/www/tpa/backend
EnvironmentFile=/var/www/tpa/backend/.env
Environment=FLASK_CONFIG=production
ExecStart=/var/www/tpa/backend/.venv/bin/flask --app wsgi media prune
