# /etc/systemd/system/tpa-membership-reconcile.timer  (example)
# Entitlements already expire on time by themselves; this keeps statuses, emails and
# Paystack in step. Hourly is plenty for day-based grace periods.
[Unit]
Description=Run tpa-membership-reconcile hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
