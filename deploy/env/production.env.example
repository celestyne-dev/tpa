# Production settings for the production API's .env  (example)
#
# The production tier runs beside staging on the same VPS and must share nothing with it:
#   production  API 127.0.0.1:8101, database tpa_production, site /var/www/tpa-production-site
#   staging     API 127.0.0.1:8100, database tpa_staging (see staging.env.example)
# Paths below follow that layout; adjust them to the server, then:
#   chmod 640 .env (owner deploy, group tpa)
#   flask --app wsgi deploy check        # must report no errors (never prints secrets);
#                                        # it refuses any staging database, prefix, path or port
# Never commit the filled-in file. Keep a copy in the password manager (it is not in backups).

FLASK_CONFIG=production
TPA_ENVIRONMENT=production
# The deployed commit (`git rev-parse --short HEAD`), shown by /api/v1/health.
TPA_RELEASE=

# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Never reuse staging's values.
SECRET_KEY=CHANGE-ME
JWT_SECRET_KEY=CHANGE-ME

DATABASE_URL=postgresql+psycopg://tpa_production:CHANGE-ME@127.0.0.1:5432/tpa_production

SITE_URL=https://thinkpositivealways.com
ADMIN_BASE_URL=https://thinkpositivealways.com
CORS_ORIGINS=https://thinkpositivealways.com

# Behind Nginx: one trusted proxy. Redis may be shared with staging only with its own prefix.
TRUST_PROXY=1
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_KEY_PREFIX=tpa-production

JWT_COOKIE_SECURE=true
CUSTOMER_COOKIE_SECURE=true

# Storage: production's own folders (never staging's).
MEDIA_ROOT=/var/lib/tpa-production/media
PRODUCT_FILES_ROOT=/var/lib/tpa-production/resources/private
UPLOAD_TEMP_ROOT=/var/lib/tpa-production/temporary/uploads
PRODUCT_FILES_ACCEL_REDIRECT_PREFIX=/_protected_downloads
BACKUP_STATUS_FILE=/var/lib/tpa-production/backup-status.json

# Publishing: the production frontend and the production API on :8101.
FRONTEND_DIR=/var/www/tpa-production/frontend
PUBLISH_RELEASES_DIR=/var/www/tpa-production-site/releases
PUBLISH_CURRENT_LINK=/var/www/tpa-production-site/current
FRONTEND_BUILD_MANIFEST=/var/www/tpa-production-site/current/prerender-manifest.json
PUBLISH_API_URL=http://127.0.0.1:8101/api/v1

MAIL_BACKEND=smtp
MAIL_FROM=Think Positive Always <no-reply@thinkpositivealways.com>
MAIL_SMTP_HOST=CHANGE-ME
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=CHANGE-ME
MAIL_SMTP_PASSWORD=CHANGE-ME

# Payments stay in test mode and live payments disabled until separately approved.
PAYSTACK_SECRET_KEY=sk_test_CHANGE-ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE-ME
PAYMENTS_LIVE_ALLOWED=false
PAYMENTS_TEST_CHECKOUT_PUBLIC=false
MEMBERSHIP_BILLING_MODE=disabled

# No bulk newsletter sending until separately approved.
NEWSLETTER_LIVE_ALLOWED=false
