# Staging / production settings for /var/www/tpa/backend/.env  (example)
#
# Only what differs from the defaults in backend/.env.example (read that file for every
# option). Copy, fill in the CHANGE-ME values, then:
#   sudo chown deploy:tpa /var/www/tpa/backend/.env && sudo chmod 640 /var/www/tpa/backend/.env
#   flask --app wsgi deploy check        # must report no errors (never prints secrets)
# Never commit the filled-in file. Keep a copy in the password manager (it is not in backups).

FLASK_CONFIG=production

# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME
JWT_SECRET_KEY=CHANGE-ME

DATABASE_URL=postgresql+psycopg://tpa:CHANGE-ME@127.0.0.1:5432/tpa

# Public origins (staging hostname until launch). All https.
SITE_URL=https://staging.example.com
ADMIN_BASE_URL=https://staging.example.com
CORS_ORIGINS=https://staging.example.com

# Behind Nginx: one trusted proxy; shared rate limits in Redis (see docs/operations.md).
TRUST_PROXY=1
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
RATELIMIT_KEY_PREFIX=tpa-staging

# Cookies are Secure in production automatically; stated here so the intent is visible.
JWT_COOKIE_SECURE=true
CUSTOMER_COOKIE_SECURE=true

# Storage (docs/hostinger-vps.md §5) and Nginx delivery of premium files.
MEDIA_ROOT=/var/lib/tpa/media
PRODUCT_FILES_ROOT=/var/lib/tpa/resources/private
UPLOAD_TEMP_ROOT=/var/lib/tpa/temporary/uploads
PRODUCT_FILES_ACCEL_REDIRECT_PREFIX=/_protected_downloads
BACKUP_STATUS_FILE=/var/lib/tpa/backup-status.json

# Publishing pipeline: prerender reads the local Gunicorn (tpa-api.service binds :8000).
FRONTEND_DIR=/var/www/tpa/frontend
PUBLISH_RELEASES_DIR=/var/www/tpa-site/releases
PUBLISH_CURRENT_LINK=/var/www/tpa-site/current
FRONTEND_BUILD_MANIFEST=/var/www/tpa-site/current/prerender-manifest.json
PUBLISH_API_URL=http://127.0.0.1:8000/api/v1

# Transactional email (invitations, password resets, receipts).
MAIL_BACKEND=smtp
MAIL_FROM=Think Positive Always <no-reply@staging.example.com>
MAIL_SMTP_HOST=CHANGE-ME
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=CHANGE-ME
MAIL_SMTP_PASSWORD=CHANGE-ME

# Payments: Paystack TEST keys only. Live payments stay disabled.
PAYSTACK_SECRET_KEY=sk_test_CHANGE-ME
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE-ME
PAYMENTS_LIVE_ALLOWED=false
PAYMENTS_TEST_CHECKOUT_PUBLIC=false
MEMBERSHIP_BILLING_MODE=disabled

# Newsletter: no bulk sending from staging.
NEWSLETTER_LIVE_ALLOWED=false
