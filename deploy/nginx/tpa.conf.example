# Nginx site for Think Positive Always (example — adjust domain and paths).
#
# - Static prerendered site from the *current* release (atomically switched symlink
#   maintained by the publishing worker: PUBLISH_CURRENT_LINK).
# - Optimised media from MEDIA_ROOT/public (never the private originals).
# - Flask API behind Gunicorn.
# - Private product files are never under a public root: only Flask can hand them out,
#   through the internal /_protected_downloads/ location (X-Accel-Redirect).
# - CMS redirects: paths without a static file are answered by Flask (/_redirect),
#   which returns a real 301/302/307/308 or 404 (then the prerendered 404 page).
#   No Nginx reload is needed when redirects change.

upstream tpa_api {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name example.com www.example.com;   # TODO: real domain once confirmed
    # Add TLS (e.g. certbot --nginx) before launch.

    root /var/www/tpa-site/current;            # = PUBLISH_CURRENT_LINK
    index index.html;

    # Optional hand-written legacy rules (prefer the CMS redirect manager).
    # include /etc/nginx/snippets/tpa-redirects.conf;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Compress text (HTML, CSS, JS, JSON, XML, SVG). Images are already optimised.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    location /api/ {
        proxy_pass http://tpa_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        client_max_body_size 2m;
    }

    # Image uploads are processed synchronously (validation + optimisation).
    location /api/v1/admin/media {
        proxy_pass http://tpa_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        client_max_body_size 21m;               # MEDIA_MAX_UPLOAD_MB + 1
    }

    # Private product file uploads (PDF/EPUB/ZIP, validated server-side before they are
    # committed to private storage). Streamed to Flask rather than buffered by Nginx.
    location ~ ^/api/v1/admin/products/[0-9]+/files {
        proxy_pass http://tpa_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 301m;              # PRODUCT_FILE_MAX_MB + 1
    }

    # Paid downloads. Flask checks the token, session and entitlement, then answers with
    # X-Accel-Redirect: /_protected_downloads/<key> (PRODUCT_FILES_ACCEL_REDIRECT_PREFIX).
    # "internal" means browsers can never request this location directly.
    location /_protected_downloads/ {
        internal;
        alias /var/lib/tpa/product-files/;      # = PRODUCT_FILES_ROOT/ (outside every web root)
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Robots-Tag "noindex" always;
    }

    # Customer area shells (cart, checkout, account): private, never cached or indexed.
    # Their data comes from /api/v1/account|cart|checkout with the customer session.
    location ~ ^/(cart|checkout|account)(/|$) {
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/index.html /404.html;
    }

    # Optimised media. Paths contain a version (v1, v2 ...) and never change once
    # written, so they can be cached for a year. Private originals live outside this
    # directory (MEDIA_ROOT/private) and are never served.
    location /media/ {
        alias /var/lib/tpa/media/public/;       # = MEDIA_ROOT/public/
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Fingerprinted build assets: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Admin SPA: client-rendered, never cached, never indexed. All admin data comes from
    # /api/v1/admin, which is authorised server-side regardless of this route.
    location /admin {
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri /admin/index.html;
    }

    # Prerendered pages: /articles/slug -> /articles/slug/index.html. HTML revalidates
    # quickly so removed articles disappear soon after a rebuild.
    location / {
        try_files $uri $uri/index.html @tpa_fallback;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }

    # No static file: ask Flask for a CMS redirect, else show the 404 page (status 404).
    location @tpa_fallback {
        proxy_pass http://tpa_api/_redirect$uri;
        proxy_set_header Host $host;
        proxy_intercept_errors on;
        error_page 404 /404.html;
    }

    location = /404.html { internal; }
    location = /prerender-manifest.json { deny all; }
    location = /redirects.json { deny all; }
}
