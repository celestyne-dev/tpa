# /etc/tpa/backup.env  (example; chmod 600, owner root) — read by tpa-backup.sh.
# Never commit the real file: it contains the database password.

# The same database the application uses (a read-only role is enough for pg_dump).
DATABASE_URL=postgresql://tpa:CHANGE-ME@127.0.0.1:5432/tpa

# Local backups on the VPS (a separate disk or volume is better than the system disk).
BACKUP_DIR=/var/backups/tpa
MEDIA_ROOT=/var/lib/tpa/media
PRODUCT_FILES_ROOT=/var/lib/tpa/resources/private

# Retention: newest N daily backups, plus the newest of each week and month.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Refuse to start when less than this much space would remain.
BACKUP_MIN_FREE_MB=1024

# Read by the application (/admin/storage): keep it in sync with backend/.env. It must be
# outside BACKUP_DIR (that folder is root-only) and readable by the "tpa" user; it holds
# no secrets (time, size, ok/failed).
BACKUP_STATUS_FILE=/var/lib/tpa/backup-status.json

# Encrypted copy for disaster recovery (outside the VPS). Use age (preferred) or GPG.
# Only PUBLIC keys live on the server; keep the secret key offline (password manager,
# printed copy). Without the secret key, an encrypted backup can't be restored.
#BACKUP_AGE_RECIPIENTS_FILE=/etc/tpa/backup-recipients.txt
#BACKUP_GPG_RECIPIENT=backups@example.com

# How the encrypted file leaves the server; {file} is replaced by its path. Examples:
#BACKUP_OFFSITE_COMMAND=rclone copy {file} offsite:tpa-backups/
#BACKUP_OFFSITE_COMMAND=rsync -e "ssh -i /root/.ssh/tpa-backup" {file} backup@storage.example.net:tpa/
#BACKUP_KEEP_ENCRYPTED_LOCAL=no

# pg_dump/pg_restore must match the server version (e.g. /usr/lib/postgresql/16/bin).
#PG_BIN=/usr/lib/postgresql/16/bin
